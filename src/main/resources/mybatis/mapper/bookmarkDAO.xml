<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.MUKJA.dao.bookmarkDAO">
	<!-- 북마크 조회 -->
	<select id="bookmarkList" resultType="com.springboot.MUKJA.dto.bookmarkDTO">
	    select b.bk_no, b.r_no, b.u_no, r.r_img, r.r_name, r.r_region
	     from bookmark b JOIN restaurant r
	     on b.r_no = r.r_no where b.u_no = #{u_no}
	</select>
	<!-- 북마크 여부 확인 -->
	
	<!-- 북마크 생성 -->
	<insert id="bookmarkInsert">
		insert into bookmark(bk_no,r_no,u_no)
		 values(bookmark_seq.NEXTVAL,#{r_no},#{u_no})
	</insert>
	
</mapper>