<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springboot.MUKJA.dao.Idv_menuDAO">

    <!-- 배달 주문 번호(d_no)에 해당하는 상세 메뉴 목록 조회 -->
    <select id="selectDeliveryMenusByOrder" parameterType="int" resultType="com.springboot.MUKJA.dto.dv_menuDTO">
        SELECT 
            dm.dvm_no,
            dm.dvm_count,
            dm.dvm_price,
            dm.d_no,
            dm.mn_no,
            m.mn_name,
            m.mn_content,
            m.mn_img
        FROM dv_menu dm
        LEFT JOIN menu m ON dm.mn_no = m.mn_no
        WHERE dm.d_no = #{d_no}
    </select>

</mapper>